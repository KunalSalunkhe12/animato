{
  "version": 1,
  "elements": {
    "hero-title": {
      "from": { "opacity": 0, "y": 30 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.9,
      "ease": "elastic.out(1, 0.3)"
    },
    "hero-subtitle": {
      "from": { "opacity": 0, "y": 20 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.8,
      "delay": 0.2,
      "ease": "power3.out"
    },
    "hero-cta": {
      "from": { "opacity": 0, "scale": 0.85 },
      "to": { "opacity": 1, "scale": 1 },
      "duration": 0.6,
      "delay": 0.45,
      "ease": "back.out(1.7)"
    },
    "spinner": {
      "to": { "rotation": 360 },
      "duration": 4,
      "repeat": -1,
      "ease": "none"
    }
  }
}
