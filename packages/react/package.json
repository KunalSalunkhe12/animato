{
  "name": "@animato/react",
  "version": "0.0.1",
  "description": "React bindings for Animato — <AnimatoProvider> and <Animato> components for GSAP animation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && node ./scripts/inject-use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "@gsap/react": ">=2.1.0",
    "gsap": ">=3.12.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@animato/core": "0.0.1"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.1",
    "@types/react": "^18.3.18",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
